# Configuración del motor de datos de la empresa
MONGO_DB=company_default_db

# Acceso principal de infraestructura corporativa
MONGO_ROOT_USER=infra_default_mgr
MONGO_ROOT_PASSWORD=insert_secure_string_alphanumeric_here

# Mantenimiento y automatización de servicios internos
ADMIN_DB_USER=internal_sync_daemon
ADMIN_DB_PASSWORD=insert_secure_string_alphanumeric_here

# Consumo de datos del lado del servidor/runtime
USUARIO_DB_USER=standard_runtime_agent
USUARIO_DB_PASSWORD=insert_secure_string_alphanumeric_here

# Seguridad y autenticación del framework de aplicaciones internas*
DJANGO_SECRET_KEY=django_core_auth_secure_key

# Hosts permitidos por Django.
# Incluye localhost para desarrollo local y admin-back para la comunicación dentro de Docker.
# En producción, reemplaza estos valores por los dominios correspondientes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,admin-back

# Frontend de usuarios
USUARIO_FRONT_URL=http://localhost:3000

# Frontend del administrador
ADMIN_FRONT_URL=http://localhost:3001

# API del usuario (Spring Boot)
USUARIO_API_URL=http://localhost:8080

# API del administrador (Django)
ADMIN_API_URL=http://localhost:8000

# Firma de los tokens de sesión del panel de administración (JWT)
DJANGO_JWT_SECRET=insert_secure_string_alphanumeric_here

# Duración del token de acceso, en minutos
JWT_ACCESO_MINUTOS=15

# Duración del token de renovación, en días
JWT_RENOVACION_DIAS=1

# Vigencia del enlace de restablecimiento de contraseña, en minutos
RECUPERACION_MINUTOS=30

# Modo de envío de correos: "consola" (desarrollo) o "smtp" (producción)
EMAIL_MODO=consola

# Servidor de correo saliente (solo se usa con EMAIL_MODO=smtp)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Cuenta del servidor de correo saliente (solo se usa con EMAIL_MODO=smtp)
EMAIL_HOST_USER=insert_mail_account_here
EMAIL_HOST_PASSWORD=insert_secure_string_alphanumeric_here

# Remitente que verá el personal en los correos del sistema
DEFAULT_FROM_EMAIL=no-responder@pikafit.pe